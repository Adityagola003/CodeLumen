# Copy this file to .env for local development.
# Never commit real API keys, passwords, or production secrets.

# Analysis engine
AI_PROVIDER=rule-based
AI_MODEL=local-rule-engine-v1
MAX_CODE_CHARS=20000
MAX_REQUEST_BYTES=1048576

# Rate limiting and caching
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=100

# Application and database
DATABASE_URL=sqlite:///./assistant.db
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720
TRUST_PROXY_HEADERS=false
ENABLE_DOCS=false
PUBLIC_ROOT_INFO=false

# Optional LLM support. Keep disabled for fully local rule-based analysis.
LLM_ENABLED=false
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=1.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s %(name)s: %(message)s
LOG_JSON=false

# Optional error tracking
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Optional email digest notifications
DIGEST_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@codelumen.ai
DIGEST_BASE_URL=http://localhost:8000

# Optional Redis/cache integration
REDIS_URL=
